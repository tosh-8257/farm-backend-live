model transfer_requests {
  id                  String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  request_reference   String                   @unique @db.VarChar(255)
  requester_user_id   String?                  @db.Uuid
  requester_wallet_id String?                  @db.Uuid
  sender_user_id      String?                  @db.Uuid
  sender_wallet_id    String?                  @db.Uuid
  amount              Decimal                  @db.Decimal(30, 8)
  currency            String?                  @default("FARM") @db.VarChar(20)
  description         String?
  status              transfer_request_status? @default(pending)
  transaction_id      String?                  @unique @db.Uuid
  expires_at          DateTime?                @db.Timestamp(6)
  accepted_at         DateTime?                @db.Timestamp(6)
  completed_at        DateTime?                @db.Timestamp(6)
  rejected_at         DateTime?                @db.Timestamp(6)
  ip_address          String?                  @db.VarChar(100)
  created_at          DateTime?                @default(now()) @db.Timestamp(6)
  updated_at          DateTime?                @default(now()) @db.Timestamp(6)
  users_requester     users?                   @relation("transfer_requests_requester", fields: [requester_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_sender        users?                   @relation("transfer_requests_sender", fields: [sender_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  wallets_requester   wallets?                 @relation("transfer_requests_requester_wallet", fields: [requester_wallet_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  wallets_sender      wallets?                 @relation("transfer_requests_sender_wallet", fields: [sender_wallet_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  transactions        transactions?            @relation(fields: [transaction_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([requester_user_id], map: "idx_transfer_requests_requester")
  @@index([sender_user_id], map: "idx_transfer_requests_sender")
  @@index([status], map: "idx_transfer_requests_status")
  @@index([sender_user_id, status, expires_at, created_at(sort: Desc)], map: "idx_transfer_requests_sender_status_expiry")
  @@index([requester_user_id, created_at(sort: Desc)], map: "idx_transfer_requests_requester_created")
}

