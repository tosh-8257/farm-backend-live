generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model activity_logs {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String?   @db.Uuid
  activity   String?   @db.VarChar(255)
  metadata   Json?
  ip_address String?   @db.VarChar(100)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  users      users?    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model api_keys {
  id              String                  @id @default(dbgenerated("gen_random_uuid()"))
  user_id         String?                 @db.Uuid
  api_key         String?
  api_key_hash    String?                 @unique
  api_secret      String?
  permissions     Json?
  last_used_at    DateTime?               @db.Timestamp(6)
  expires_at      DateTime?               @db.Timestamp(6)
  created_at      DateTime?               @default(now()) @db.Timestamp(6)
  users           users?                  @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  // V2 Phase 3: business developer API keys (sandbox/live)
  business_id     String?                 @db.Uuid
  name            String?                 @db.VarChar(120)
  mode            String?                 @db.VarChar(10)
  key_prefix      String?                 @db.VarChar(40)
  status          String?                 @default("active") @db.VarChar(20)
  revoked_at      DateTime?               @db.Timestamp(6)
  rotated_from_id String?
  business        businesses?             @relation("api_keys_business", fields: [business_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  requests        business_api_requests[]

  @@index([business_id, mode])
}

model audit_logs {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String?   @db.Uuid
  action      String?   @db.VarChar(255)
  entity_type String?   @db.VarChar(255)
  entity_id   String?   @db.Uuid
  old_values  Json?
  new_values  Json?
  ip_address  String?   @db.VarChar(100)
  user_agent  String?
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  users       users?    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model beneficiaries {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String?   @db.Uuid
  beneficiary_name String?   @db.VarChar(255)
  wallet_address   String?   @db.VarChar(255)
  phone            String?   @db.VarChar(20)
  created_at       DateTime? @default(now()) @db.Timestamp(6)
  users            users?    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model blockchain_transactions {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transaction_id   String?       @db.Uuid
  blockchain_name  String?       @default("algorand") @db.VarChar(100)
  tx_hash          String?
  sender_address   String?
  receiver_address String?
  asset_id         String?       @db.VarChar(255)
  amount           Decimal?      @db.Decimal(30, 8)
  confirmations    Int?          @default(0)
  network_fee      Decimal?      @db.Decimal(30, 8)
  status           String?       @default("pending") @db.VarChar(50)
  raw_response     Json?
  created_at       DateTime?     @default(now()) @db.Timestamp(6)
  transactions     transactions? @relation(fields: [transaction_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model contacts {
  id                                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id                              String?   @db.Uuid
  contact_user_id                       String?   @db.Uuid
  nickname                              String?   @db.VarChar(255)
  created_at                            DateTime? @default(now()) @db.Timestamp(6)
  users_contacts_contact_user_idTousers users?    @relation("contacts_contact_user_idTousers", fields: [contact_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_contacts_owner_idTousers        users?    @relation("contacts_owner_idTousers", fields: [owner_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model cross_border_transfers {
  id                                                   String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sender_user_id                                       String?             @db.Uuid
  receiver_user_id                                     String?             @db.Uuid
  sender_country                                       String?             @db.VarChar(100)
  receiver_country                                     String?             @db.VarChar(100)
  source_currency                                      String?             @db.VarChar(20)
  destination_currency                                 String?             @db.VarChar(20)
  source_amount                                        Decimal?            @db.Decimal(30, 8)
  destination_amount                                   Decimal?            @db.Decimal(30, 8)
  exchange_rate                                        Decimal?            @db.Decimal(30, 8)
  transaction_id                                       String?             @db.Uuid
  status                                               transaction_status? @default(pending)
  created_at                                           DateTime?           @default(now()) @db.Timestamp(6)
  users_cross_border_transfers_receiver_user_idTousers users?              @relation("cross_border_transfers_receiver_user_idTousers", fields: [receiver_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_cross_border_transfers_sender_user_idTousers   users?              @relation("cross_border_transfers_sender_user_idTousers", fields: [sender_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  transactions                                         transactions?       @relation(fields: [transaction_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model escrow_contracts {
  id                                                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reference_code                                     String            @unique @db.VarChar(255)
  buyer_id                                           String?           @db.Uuid
  seller_id                                          String?           @db.Uuid
  arbiter_id                                         String?           @db.Uuid
  buyer_wallet_id                                    String?           @db.Uuid
  seller_wallet_id                                   String?           @db.Uuid
  amount                                             Decimal           @db.Decimal(30, 8)
  fee                                                Decimal?          @default(0) @db.Decimal(30, 8)
  status                                             escrow_status?    @default(pending)
  title                                              String?           @db.VarChar(255)
  description                                        String?
  evidence                                           Json?
  funded_at                                          DateTime?         @db.Timestamp(6)
  released_at                                        DateTime?         @db.Timestamp(6)
  disputed_at                                        DateTime?         @db.Timestamp(6)
  resolved_at                                        DateTime?         @db.Timestamp(6)
  auto_release_at                                    DateTime?         @db.Timestamp(6)
  resolution_note                                    String?
  /// V2 Phase 2b: running total released milestone-by-milestone.
  released_amount                                    Decimal           @default(0) @db.Decimal(30, 8)
  created_at                                         DateTime?         @default(now()) @db.Timestamp(6)
  updated_at                                         DateTime?         @default(now()) @db.Timestamp(6)
  users_escrow_contracts_arbiter_idTousers           users?            @relation("escrow_contracts_arbiter_idTousers", fields: [arbiter_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_escrow_contracts_buyer_idTousers             users?            @relation("escrow_contracts_buyer_idTousers", fields: [buyer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  wallets_escrow_contracts_buyer_wallet_idTowallets  wallets?          @relation("escrow_contracts_buyer_wallet_idTowallets", fields: [buyer_wallet_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_escrow_contracts_seller_idTousers            users?            @relation("escrow_contracts_seller_idTousers", fields: [seller_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  wallets_escrow_contracts_seller_wallet_idTowallets wallets?          @relation("escrow_contracts_seller_wallet_idTowallets", fields: [seller_wallet_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  escrow_messages                                    escrow_messages[]
  business_escrow                                    business_escrows?
}

model escrow_messages {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  escrow_id        String?           @db.Uuid
  sender_id        String?           @db.Uuid
  message          String?
  attachment_url   String?
  created_at       DateTime?         @default(now()) @db.Timestamp(6)
  escrow_contracts escrow_contracts? @relation(fields: [escrow_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users            users?            @relation(fields: [sender_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model exchange_rates {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  base_currency   String?   @db.VarChar(20)
  target_currency String?   @db.VarChar(20)
  rate            Decimal?  @db.Decimal(30, 8)
  provider        String?   @db.VarChar(100)
  fetched_at      DateTime? @default(now()) @db.Timestamp(6)
}

model currency_rates {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usd_kes_rate  Decimal   @db.Decimal(30, 8)
  farm_kes_rate Decimal   @default(1) @db.Decimal(30, 8)
  is_active     Boolean   @default(true)
  effective_at  DateTime  @default(now()) @db.Timestamp(6)
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  updated_at    DateTime? @default(now()) @db.Timestamp(6)
  updated_by    String?   @db.Uuid
  users         users?    @relation(fields: [updated_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([is_active], map: "idx_currency_rates_active")
}

model farm_token_config {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  asset_id          String?           @db.VarChar(255)
  token_name        String?           @db.VarChar(255)
  token_symbol      String?           @db.VarChar(50)
  total_supply      Decimal?          @db.Decimal(30, 8)
  decimals          Int?              @default(6)
  creator_wallet_id String?           @db.Uuid
  created_at        DateTime?         @default(now()) @db.Timestamp(6)
  treasury_wallets  treasury_wallets? @relation(fields: [creator_wallet_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model fee_configurations {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transaction_type String?   @db.VarChar(100)
  flat_fee         Decimal?  @default(0) @db.Decimal(30, 8)
  percentage_fee   Decimal?  @default(0) @db.Decimal(10, 4)
  minimum_fee      Decimal?  @default(0) @db.Decimal(30, 8)
  maximum_fee      Decimal?  @default(0) @db.Decimal(30, 8)
  is_active        Boolean?  @default(true)
  created_at       DateTime? @default(now()) @db.Timestamp(6)
  label                 String?   @db.VarChar(120)
  description           String?
  payer                 String?   @db.VarChar(20)
  destination_wallet_id String?   @db.Uuid
  updated_at            DateTime? @db.Timestamp(6)
  updated_by            String?   @db.Uuid
}

model investment_projects {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_name       String               @db.VarChar(255)
  category           String?              @db.VarChar(100)
  description        String?
  banner_image       String?
  target_amount      Decimal?             @db.Decimal(30, 8)
  raised_amount      Decimal?             @default(0) @db.Decimal(30, 8)
  minimum_investment Decimal?             @db.Decimal(30, 8)
  roi_percent        Decimal?             @db.Decimal(10, 2)
  duration_months    Int?
  total_backers      Int?                 @default(0)
  status             String?              @default("open") @db.VarChar(50)
  starts_at          DateTime?            @db.Timestamp(6)
  ends_at            DateTime?            @db.Timestamp(6)
  created_by         String?              @db.Uuid
  created_at         DateTime?            @default(now()) @db.Timestamp(6)
  updated_at         DateTime?            @default(now()) @db.Timestamp(6)
  users              users?               @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user_investments   user_investments[]
  // ---- V2 Phase 4: business-submitted projects (canonical project model) ----
  business_id        String?              @db.Uuid
  sector             String?              @db.VarChar(40)
  summary            String?              @db.VarChar(500)
  location           String?              @db.VarChar(255)
  country            String?              @db.VarChar(2)
  currency           String               @default("FARM") @db.VarChar(10)
  maximum_investment Decimal?             @db.Decimal(30, 8)
  instrument_type    String?              @db.VarChar(30)
  use_of_funds       String?
  risk_factors       String?
  team               String?
  review_notes       String?
  submitted_at       DateTime?            @db.Timestamptz(6)
  approved_at        DateTime?            @db.Timestamptz(6)
  listed_at          DateTime?            @db.Timestamptz(6)
  reviewed_by        String?              @db.Uuid
  /// Funds released to the business so far (milestone by milestone)
  released_amount    Decimal              @default(0) @db.Decimal(30, 8)
  consolidation_fee    Decimal            @default(0) @db.Decimal(30, 8)
  consolidation_fee_at DateTime?          @db.Timestamptz(6)
  consolidation_refunded Decimal          @default(0) @db.Decimal(30, 8)
  consolidation_released Decimal          @default(0) @db.Decimal(30, 8)
  /// Token buybacks paid from this project's consolidation reserve
  consolidation_bought_back Decimal       @default(0) @db.Decimal(30, 8)
  milestones         project_milestones[]
  token              project_tokens?
  business           businesses?          @relation("business_projects", fields: [business_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  documents          project_documents[]
  reviews            project_reviews[]
  updates            project_updates[]

  @@index([business_id])
  @@index([status, sector])
}

model kyc_documents {
  id                                     String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                                String?     @db.Uuid
  document_type                          String?
  front_image                            String?
  back_image                             String?
  selfie_image                           String?
  document_number                        String?
  status                                 kyc_status? @default(pending)
  reviewed_by                            String?     @db.Uuid
  rejection_reason                       String?
  reviewed_at                            DateTime?
  created_at                             DateTime?   @default(now())
  address_document                       String?
  back_image_url                         String?
  city                                   String?
  country                                String?
  county                                 String?
  date_of_birth                          DateTime?
  email                                  String?
  first_name                             String?
  front_image_url                        String?
  gender                                 String?
  last_name                              String?
  nationality                            String?
  phone                                  String?
  physical_address                       String?
  postal_code                            String?
  selfie_image_url                       String?
  users_kyc_documents_reviewed_byTousers users?      @relation("kyc_documents_reviewed_byTousers", fields: [reviewed_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_kyc_documents_user_idTousers     users?      @relation("kyc_documents_user_idTousers", fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model didit_webhook_events {
  event_id     String   @id @db.VarChar(128)
  webhook_type String?
  session_id   String?
  status       String?
  processed_at DateTime @default(now()) @db.Timestamptz(6)
}

model ledger_entries {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transaction_id String?       @db.Uuid
  wallet_id      String?       @db.Uuid
  entry_type     String        @db.VarChar(20)
  amount         Decimal       @db.Decimal(30, 8)
  balance_before Decimal?      @db.Decimal(30, 8)
  balance_after  Decimal?      @db.Decimal(30, 8)
  description    String?
  category       String?       @db.VarChar(40)
  created_at     DateTime?     @default(now()) @db.Timestamp(6)
  transactions   transactions? @relation(fields: [transaction_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  wallets        wallets?      @relation(fields: [wallet_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([transaction_id], map: "idx_ledger_transaction")
  @@index([wallet_id], map: "idx_ledger_wallet")
}

model merchant_payouts {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchant_id    String?             @db.Uuid
  amount         Decimal?            @db.Decimal(30, 8)
  payout_method  String?             @db.VarChar(100)
  account_name   String?             @db.VarChar(255)
  account_number String?             @db.VarChar(255)
  status         transaction_status? @default(pending)
  processed_by   String?             @db.Uuid
  processed_at   DateTime?           @db.Timestamp(6)
  created_at     DateTime?           @default(now()) @db.Timestamp(6)
  merchants      merchants?          @relation(fields: [merchant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users          users?              @relation(fields: [processed_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model merchants {
  id                                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                            String?            @db.Uuid
  business_name                      String             @db.VarChar(255)
  business_email                     String?            @db.VarChar(255)
  business_phone                     String?            @db.VarChar(20)
  business_type                      String?            @db.VarChar(100)
  business_registration_number       String?            @db.VarChar(255)
  business_logo                      String?
  country                            String?            @db.VarChar(100)
  city                               String?            @db.VarChar(100)
  address                            String?
  qr_code                            String?
  qr_secret                          String?
  status                             merchant_status?   @default(pending)
  daily_limit                        Decimal?           @default(0) @db.Decimal(30, 8)
  transaction_fee_percent            Decimal?           @default(0) @db.Decimal(10, 2)
  total_sales                        Decimal?           @default(0) @db.Decimal(30, 8)
  approved_by                        String?            @db.Uuid
  approved_at                        DateTime?          @db.Timestamp(6)
  created_at                         DateTime?          @default(now()) @db.Timestamp(6)
  updated_at                         DateTime?          @default(now()) @db.Timestamp(6)
  merchant_payouts                   merchant_payouts[]
  payment_receipts                   payment_receipts[]
  users_merchants_approved_byTousers users?             @relation("merchants_approved_byTousers", fields: [approved_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_merchants_user_idTousers     users?             @relation("merchants_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  qr_payments                        qr_payments[]
  business                           businesses?
}

model notifications {
  id         String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String?            @db.Uuid
  type       notification_type?
  title      String?            @db.VarChar(255)
  body       String?
  metadata   Json?
  is_read    Boolean?           @default(false)
  created_at DateTime?          @default(now()) @db.Timestamp(6)
  users      users?             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, created_at(sort: Desc)], map: "idx_notifications_user_created")
  @@index([user_id, is_read], map: "idx_notifications_user_read")
}

model otp_verifications {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String?   @db.Uuid
  otp_code   String    @db.Text
  purpose    String?   @db.VarChar(50)
  attempts   Int?      @default(0)
  verified   Boolean?  @default(false)
  expires_at DateTime? @db.Timestamp(6)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  users      users?    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model qr_payments {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchant_id    String?             @db.Uuid
  customer_id    String?             @db.Uuid
  transaction_id String?             @db.Uuid
  qr_payload     String?
  amount         Decimal?            @db.Decimal(30, 8)
  status         transaction_status? @default(pending)
  scanned_at     DateTime?           @db.Timestamp(6)
  created_at     DateTime?           @default(now()) @db.Timestamp(6)
  users          users?              @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  merchants      merchants?          @relation(fields: [merchant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  transactions   transactions?       @relation(fields: [transaction_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model roi_payouts {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  investment_id    String?           @db.Uuid
  amount           Decimal?          @db.Decimal(30, 8)
  transaction_id   String?           @db.Uuid
  payout_date      DateTime?         @db.Timestamp(6)
  created_at       DateTime?         @default(now()) @db.Timestamp(6)
  user_investments user_investments? @relation(fields: [investment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  transactions     transactions?     @relation(fields: [transaction_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model security_events {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String?   @db.Uuid
  event_type  String?   @db.VarChar(255)
  description String?
  severity    String?   @db.VarChar(50)
  ip_address  String?   @db.VarChar(100)
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  users       users?    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model support_messages {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticket_id       String?          @db.Uuid
  sender_id       String?          @db.Uuid
  message         String?
  attachment_url  String?
  created_at      DateTime?        @default(now()) @db.Timestamp(6)
  users           users?           @relation(fields: [sender_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  support_tickets support_tickets? @relation(fields: [ticket_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model support_tickets {
  id                                       String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                                  String?            @db.Uuid
  subject                                  String?            @db.VarChar(255)
  message                                  String?
  status                                   String?            @default("open") @db.VarChar(50)
  priority                                 String?            @default("medium") @db.VarChar(50)
  assigned_to                              String?            @db.Uuid
  closed_at                                DateTime?          @db.Timestamp(6)
  created_at                               DateTime?          @default(now()) @db.Timestamp(6)
  support_messages                         support_messages[]
  users_support_tickets_assigned_toTousers users?             @relation("support_tickets_assigned_toTousers", fields: [assigned_to], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_support_tickets_user_idTousers     users?             @relation("support_tickets_user_idTousers", fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model system_settings {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  setting_key   String?   @unique @db.VarChar(255)
  setting_value String?
  description   String?
  updated_by    String?   @db.Uuid
  updated_at    DateTime? @default(now()) @db.Timestamp(6)
  users         users?    @relation(fields: [updated_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model transactions {
  id                                               String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transaction_reference                            String                    @unique @db.VarChar(255)
  sender_wallet_id                                 String?                   @db.Uuid
  receiver_wallet_id                               String?                   @db.Uuid
  transaction_type                                 transaction_type
  status                                           transaction_status?       @default(pending)
  amount                                           Decimal                   @db.Decimal(30, 8)
  fee                                              Decimal?                  @default(0) @db.Decimal(30, 8)
  net_amount                                       Decimal?                  @default(0) @db.Decimal(30, 8)
  currency                                         String?                   @default("FARM") @db.VarChar(20)
